# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# fixtures de identidad para pruebas locales de extracción — NUNCA se versionan
supabase/dev-fixtures/*
!supabase/dev-fixtures/README.md

# salida de las pruebas E2E (Playwright) — ver e2e/README.md
/test-results/
/playwright-report/
/blob-report/

# instantáneas de datos reales (respaldo local de migraciones de datos) — NUNCA se versionan
/legacy-backup/precios-fijos-2026-09-18/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
