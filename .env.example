# ===========================================================================
# MotoDS — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está ignorado por git; este `.env.example` sí se versiona.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase
# Panel: https://supabase.com/dashboard/project/<project-ref>/settings/api
# ---------------------------------------------------------------------------

# URL base del proyecto Supabase.
# PÚBLICA: se inyecta en el bundle del navegador (prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Clave "anon" (publishable).
# PÚBLICA: se inyecta en el navegador. No es un secreto: el acceso real a los
# datos lo controla Row Level Security (RLS) en la base de datos, no esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clave "service_role".
# SECRETA · SOLO SERVIDOR. Ignora RLS por completo (acceso total a la BD).
# Nunca la prefijes con NEXT_PUBLIC_ ni la importes en componentes de cliente.
# Uso: seeds, migraciones de datos, tareas administrativas, scripts.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------

# URL pública de la app. Se usa para construir los enlaces de retorno de auth
# (magic links, confirmación de correo, callback de OAuth).
# En local: http://localhost:3000 — en producción: el dominio real.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Base de datos (OPCIONAL)
# Solo si usas migraciones/ORM/scripts que se conectan directo a Postgres.
# SECRETA · SOLO SERVIDOR.
# Panel: https://supabase.com/dashboard/project/<project-ref>/settings/database
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# ---------------------------------------------------------------------------
# Correo de invitación de vendedores (Resend) — OPCIONAL
# SECRETAS · SOLO SERVIDOR (nunca con prefijo NEXT_PUBLIC_).
# Sin ellas, invitar funciona igual: el correo queda "no enviado" y el admin
# comparte el enlace con "Copiar enlace" o "Enviar por WhatsApp".
# El remitente debe ser de un dominio VERIFICADO en Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
SMILE_INVITATION_FROM_EMAIL="Smile Motors <no-reply@tu-dominio.com>"

# ---------------------------------------------------------------------------
# Pruebas E2E / integración (SOLO local — nunca en Vercel ni en el repo)
# Contraseña de las cuentas de prueba e2e-*@motods.test. Genera una aleatoria
# larga; las pruebas y los scripts de integración la leen de aquí.
# ---------------------------------------------------------------------------
E2E_PASSWORD=""

# --- Notificaciones push (Web Push / VAPID) ---------------------------------
# Generar una vez con:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# La PRIVADA es un secreto de servidor: nunca NEXT_PUBLIC_, nunca en el cliente.
# Sin estas variables la app funciona igual y el push queda desactivado.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:tu-contacto@smilemotors.com
