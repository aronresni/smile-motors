# ===========================================================================
# MotoDS — variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está ignorado por git; este `.env.example` sí se versiona.
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase
# Panel: https://supabase.com/dashboard/project/cubjavutpooievkhxdhp/settings/api
# ---------------------------------------------------------------------------

# URL base del proyecto Supabase.
# PÚBLICA: se inyecta en el bundle del navegador (prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL="https://cubjavutpooievkhxdhp.supabase.co"

# Clave "anon" (publishable).
# PÚBLICA: se inyecta en el navegador. No es un secreto: el acceso real a los
# datos lo controla Row Level Security (RLS) en la base de datos, no esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clave "service_role".
# SECRETA · SOLO SERVIDOR. Ignora RLS por completo (acceso total a la BD).
# Nunca la prefijes con NEXT_PUBLIC_ ni la importes en componentes de cliente.
# Uso: seeds, migraciones de datos, tareas administrativas, scripts.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------

# URL pública de la app. Se usa para construir los enlaces de retorno de auth
# (magic links, confirmación de correo, callback de OAuth).
# En local: http://localhost:3000 — en producción: el dominio real.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Base de datos (OPCIONAL)
# Solo si usas migraciones/ORM/scripts que se conectan directo a Postgres.
# SECRETA · SOLO SERVIDOR.
# Panel: https://supabase.com/dashboard/project/cubjavutpooievkhxdhp/settings/database
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.cubjavutpooievkhxdhp.supabase.co:5432/postgres"
